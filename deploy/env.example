# ~/.config/powerline-bot/env  (chmod 600: it holds secrets)
# Same POWERLINE_AGENT_KEY on every machine.
POWERLINE_AGENT_KEY=change-me-long-random-secret

# Coordinator machine only:
WEBSHARE_API_KEY=your-webshare-api-key
POWERLINE_DASHBOARD_PASSWORD=change-me
COORDINATOR_ARGS=--listen 0.0.0.0 --dashboard 0.0.0.0 --headless --local-max-bots 1 --groups 5 --bots-per-proxy 3 --start-stopped

# Agent machines only:
AGENT_ARGS=--coordinator 192.168.1.96 --headless
